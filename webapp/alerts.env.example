# Copy this file to alerts.env (same directory) and fill in your
# own address. alerts.env is gitignored -- keep real addresses and
# any SMTP credentials out of the repo.
#
#   cp webapp/alerts.env.example webapp/alerts.env
#   $EDITOR webapp/alerts.env
#   systemctl --user restart lab-status
#
# Leaving ALERT_EMAIL_TO unset disables alerting entirely -- the
# dashboard and its /api/status endpoint work fine either way.

ALERT_EMAIL_TO=you@example.com

# Optional -- defaults shown. Uncomment to override.

# Sender address on outgoing alert emails.
#ALERT_EMAIL_FROM=lab-status@your-hostname

# This host's local sendmail/postfix relay needs no credentials.
# Point these at an external SMTP provider (e.g. Gmail with an App
# Password) instead if this machine has no working local relay.
#SMTP_HOST=localhost
#SMTP_PORT=25
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_USE_TLS=false

# How often the background thread re-checks disk/load/swap.
#ALERT_CHECK_INTERVAL_SECONDS=60

# Minimum minutes between repeat alerts for the same still-critical
# condition (it won't re-alert every single check interval).
#ALERT_COOLDOWN_MINUTES=60
